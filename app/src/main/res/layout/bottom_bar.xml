<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frameLayout"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:background="#1E3A5F"
    android:gravity="center"
    android:orientation="horizontal">

    <!-- BOTÓN 1 -->
    <LinearLayout
        android:id="@+id/llBotonMenuPrincipal"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivIconoNuevo1"
            android:layout_width="43dp"
            android:layout_height="36dp"
            android:src="@drawable/iconomenuprincipal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Biblioteca"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- BOTÓN 2 -->
    <LinearLayout
        android:id="@+id/llCatalogo"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="43dp"
            android:layout_height="36dp"
            android:src="@drawable/iconodebiblioteca" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/catalogo"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- BOTÓN 3 -->
    <LinearLayout
        android:id="@+id/llContileyendo"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="57dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_media_play" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/contileyen"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- BOTÓN 4 -->
    <LinearLayout
        android:id="@+id/llMicrofono"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="43dp"
            android:layout_height="36dp"
            android:src="@drawable/microfono" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscar"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>