<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContinuarLeyendo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F2">

    <!-- CABECERA AZUL -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="146dp"
        android:layout_alignParentTop="true"
        android:background="#1E3A5F"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme" />

    <ImageView
        android:id="@+id/ivPerfil"
        android:layout_width="85dp"
        android:layout_height="76dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="13dp"
        android:contentDescription="@string/perfil"
        app:srcCompat="@drawable/usuarioleyendocfmenuprinc" />

    <ImageView
        android:id="@+id/imageViewLogo"
        android:layout_width="91dp"
        android:layout_height="49dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:contentDescription="@string/app_name"
        app:srcCompat="@drawable/logocfmenuprin" />

    <ImageButton
        android:id="@+id/btnVolver"
        android:layout_width="57dp"
        android:layout_height="57dp"
        android:layout_below="@+id/imageViewLogo"
        android:layout_alignParentStart="true"
        android:layout_marginStart="8dp"
        android:layout_marginTop="23dp"
        android:background="@null"
        android:contentDescription="@string/volver"
        android:src="@android:drawable/ic_menu_revert" />

    <!-- LÍNEA DORADA -->
    <View
        android:id="@+id/vLinea"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_below="@id/toolbar"
        android:background="#F2C94C" />

    <!-- CONTENIDO -->
    <ScrollView
        android:id="@+id/svLibroActual"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomBar"
        android:layout_below="@id/vLinea">

        <LinearLayout
            android:id="@+id/llContenidoLibro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- PORTADA DESDE FIREBASE -->
            <ImageView
                android:id="@+id/ivPortadaLibroActual"
                android:layout_width="203dp"
                android:layout_height="281dp"
                android:layout_marginTop="24dp"
                android:background="#C9CDE5"
                android:contentDescription="Portada libro actual"
                android:scaleType="centerCrop"
                tools:srcCompat="@tools:sample/avatars" />

            <TextView
                android:id="@+id/tvTituloLibroActual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/titulo"
                android:textColor="#1E3A5F"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAbrirPdfTexto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Pulsa la portada para abrir el libro"
                android:textColor="#666666"
                android:textSize="14sp" />
        <Button
            android:id="@+id/btnEscribirResena"
            android:layout_width="180dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#1E3A5F"
            android:text="Escribir reseña"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomBar"
        layout="@layout/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>

</RelativeLayout>