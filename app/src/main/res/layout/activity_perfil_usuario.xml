<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootPerfilUsuario"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F2">

    <ScrollView
        android:id="@+id/svPerfil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBar">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/llCabecera"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:background="#1E3A5F"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageButton
                    android:id="@+id/btnVolver"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Volver"
                    android:src="@android:drawable/ic_media_previous" />

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/logocfmenuprin" />

            </LinearLayout>

            <ImageView
                android:id="@+id/ivAvatarUsuario"
                android:layout_width="144dp"
                android:layout_height="144dp"
                android:layout_below="@id/llCabecera"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="-48dp"
                android:contentDescription="Avatar usuario"
                android:padding="16dp"
                android:src="@drawable/usuarioleyendocfmenuprinc" />

            <TextView
                android:id="@+id/tvInfoPersonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/ivAvatarUsuario"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="8dp"
                android:paddingStart="24dp"
                android:paddingTop="8dp"
                android:paddingEnd="24dp"
                android:paddingBottom="8dp"
                android:text="@string/info_personal"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/llContenido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvInfoPersonal"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvNombre"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="#FFFFFF"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="8dp"
                        android:text="@string/nombre"
                        android:textColor="#1E3A5F" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/tvApellido"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="#FFFFFF"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="8dp"
                        android:text="@string/apellidos"
                        android:textColor="#1E3A5F" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvFechaNacimiento"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="#FFFFFF"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:text="@string/fenacim"
                    android:textColor="#1E3A5F" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvLocalidad"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="#FFFFFF"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="8dp"
                        android:text="@string/localidad"
                        android:textColor="#1E3A5F" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/tvMunicipio"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="#FFFFFF"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="8dp"
                        android:text="@string/Municipio"
                        android:textColor="#1E3A5F" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvPais"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="#FFFFFF"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:text="@string/pais"
                    android:textColor="#1E3A5F" />

            </LinearLayout>

        </RelativeLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomBar"
        layout="@layout/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_alignParentBottom="true" />

</RelativeLayout>