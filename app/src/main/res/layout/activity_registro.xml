<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/svEspacio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F3F3F3">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <ImageView
            android:id="@+id/ivLogoRegistro"
            android:layout_width="145dp"
            android:layout_height="145dp"
            android:layout_marginTop="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logogbsinfondoregistro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/volver"
            android:src="@android:drawable/ic_media_previous"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivUsuario"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/usuarioleyendocf"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUploadProfileImage"
            android:layout_width="118dp"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#1E3A5F"
            android:text="Foto"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:cornerRadius="10dp"
            app:icon="@android:drawable/ic_menu_camera"
            app:iconGravity="textStart"
            app:iconSize="16dp"
            app:layout_constraintEnd_toEndOf="@id/ivUsuario"
            app:layout_constraintStart_toStartOf="@id/ivUsuario"
            app:layout_constraintTop_toBottomOf="@id/ivUsuario" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/llEspacioRegistro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_input"
            android:backgroundTint="@android:color/white"
            android:elevation="4dp"
            android:padding="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnUploadProfileImage">

            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/nombre"
                android:textColor="#222222"
                android:textSize="16sp"
                app:layout_constraintEnd_toStartOf="@id/tvApellido"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvApellido"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/apellidos"
                android:textColor="#222222"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvNombre"
                app:layout_constraintTop_toTopOf="@id/tvNombre" />

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="154dp"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:hint="@string/nombre"
                android:inputType="textPersonName"
                android:padding="12dp"
                app:layout_constraintEnd_toEndOf="@id/tvNombre"
                app:layout_constraintStart_toStartOf="@id/tvNombre"
                app:layout_constraintTop_toBottomOf="@id/tvNombre" />

            <EditText
                android:id="@+id/etApellidos"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="@string/apellidos"
                android:inputType="textPersonName"
                android:padding="12dp"
                app:layout_constraintEnd_toEndOf="@id/tvApellido"
                app:layout_constraintStart_toStartOf="@id/tvApellido"
                app:layout_constraintTop_toBottomOf="@id/tvApellido" />

            <TextView
                android:id="@+id/tvFechaNac"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/fenacim"
                android:textColor="#222222"
                android:textSize="16sp"
                app:layout_constraintEnd_toStartOf="@id/tvRol"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etNombre" />

            <TextView
                android:id="@+id/tvRol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/rol"
                android:textColor="#222222"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvFechaNac"
                app:layout_constraintTop_toTopOf="@id/tvFechaNac" />

            <EditText
                android:id="@+id/etFechaNacimiento"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="@string/formato_fecha"
                android:inputType="number"
                android:maxLength="10"
                android:padding="12dp"
                app:layout_constraintEnd_toEndOf="@id/tvFechaNac"
                app:layout_constraintStart_toStartOf="@id/tvFechaNac"
                app:layout_constraintTop_toBottomOf="@id/tvFechaNac" />

            <Spinner
                android:id="@+id/spinnerRole"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:padding="8dp"
                app:layout_constraintEnd_toEndOf="@id/tvRol"
                app:layout_constraintStart_toStartOf="@id/tvRol"
                app:layout_constraintTop_toBottomOf="@id/tvRol" />

            <TextView
                android:id="@+id/tvDireccion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/direcci"
                android:textColor="#222222"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etFechaNacimiento" />

            <EditText
                android:id="@+id/etLocalidad"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="@string/localidad"
                android:padding="12dp"
                app:layout_constraintEnd_toStartOf="@id/etMunicipio"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDireccion" />

            <EditText
                android:id="@+id/etMunicipio"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_input"
                android:hint="@string/Municipio"
                android:padding="12dp"
                app:layout_constraintEnd_toStartOf="@id/etPais"
                app:layout_constraintStart_toEndOf="@id/etLocalidad"
                app:layout_constraintTop_toBottomOf="@id/tvDireccion" />

            <EditText
                android:id="@+id/etPais"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="@string/pais"
                android:padding="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/etMunicipio"
                app:layout_constraintTop_toBottomOf="@id/tvDireccion" />

            <TextView
                android:id="@+id/tvIdioma"
                android:layout_width="157dp"
                android:layout_height="27dp"
                android:layout_marginTop="16dp"
                android:text="@string/idiomas"
                android:textColor="#222222"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etLocalidad" />

            <Spinner
                android:id="@+id/spinnerNativeLanguage"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:padding="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvIdioma" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_UploadCertificate"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#1E3A5F"
                android:text="@string/certificado"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_menu_upload"
                app:iconGravity="textStart"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/spinnerNativeLanguage" />

            <TextView
                android:id="@+id/tvCorreo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/correo"
                android:textColor="#222222"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_UploadCertificate"
                app:layout_goneMarginTop="18dp" />

            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="@string/ejemplo_correo"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCorreo" />

            <TextView
                android:id="@+id/tvRepetirCorreo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/rep_correo"
                android:textColor="#222222"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etCorreo" />

            <EditText
                android:id="@+id/etRepetirCorreo"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="@string/rep_correo"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvRepetirCorreo" />

            <TextView
                android:id="@+id/tvContrasenia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="8dp"
                android:text="@string/contrasenia"
                android:textColor="#222222"
                android:textSize="16sp"
                app:layout_constraintEnd_toStartOf="@id/tvRepetirContrasenia"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etRepetirCorreo" />

            <TextView
                android:id="@+id/tvRepetirContrasenia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/rep_contrasenia"
                android:textColor="#222222"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvContrasenia"
                app:layout_constraintTop_toTopOf="@id/tvContrasenia" />

            <EditText
                android:id="@+id/etContrasenia"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="@string/min_6_carac"
                android:inputType="textPassword"
                android:padding="12dp"
                app:layout_constraintEnd_toEndOf="@id/tvContrasenia"
                app:layout_constraintStart_toStartOf="@id/tvContrasenia"
                app:layout_constraintTop_toBottomOf="@id/tvContrasenia" />

            <EditText
                android:id="@+id/etRepetirContrasenia"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="@string/rep_contrasenia"
                android:inputType="textPassword"
                android:padding="12dp"
                app:layout_constraintEnd_toEndOf="@id/tvRepetirContrasenia"
                app:layout_constraintStart_toStartOf="@id/tvRepetirContrasenia"
                app:layout_constraintTop_toBottomOf="@id/tvRepetirContrasenia" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrar"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="#F2C94C"
                android:text="@string/Registrarse"
                android:textAllCaps="false"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etRepetirContrasenia" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>